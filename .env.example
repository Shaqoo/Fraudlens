# Copy to .env and fill in real values. Never commit .env.

# Hugging Face (secondary dataset: creditcard.csv mirror, no token needed for public repos)
HF_DATASET_ID=David-Egea/Creditcard-fraud-detection
HF_TOKEN=

# Kaggle (primary dataset: PaySim synthetic mobile money transactions)
# Also accepted via ~/.kaggle/kaggle.json
KAGGLE_DATASET_ID=ealaxi/paysim1
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# PostgreSQL
DATABASE_URL=postgresql+psycopg://fraudlens_user:your_password@localhost:5432/fraudlens

# Model
MODEL_PATH=models/fraud_model.joblib
PREDICT_THRESHOLD=0.5

# Analyzed predictions (OCR image / pasted text)
OCR_BACKEND=auto
MAX_EXTRACT_MB=5

# API behaviour
MAX_BATCH_SIZE=1000
PERSIST_PREDICTIONS=true

# Observability
LOG_LEVEL=INFO
